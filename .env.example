# Documents the variables the service reads. Go reads no .env file itself: a
# twelve-factor process takes its configuration from the environment. Keep any
# real file OUTSIDE this directory and export it into the shell first:
#
#   set -a; . "$HOME/.secrets/go-standards.env"; set +a
#
# Ignoring a file stops it reaching a commit, not a reader. AI assistants,
# editor extensions, and language servers read anything inside the project.

# Required, no default. A missing value stops startup.
DATABASE_URL=
API_TOKEN=

# Optional, shown with their defaults.
SERVICE_NAME=go-standards-demo
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Read only by docker compose for the local database container.
POSTGRES_PASSWORD=
